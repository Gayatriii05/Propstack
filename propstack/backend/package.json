{
  "name": "propstack-backend",
  "version": "1.0.0",
  "description": "PropStack - Multi-Tenant Property & Lease Management API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:setup": "node src/utils/setupDb.js",
